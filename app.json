{
  "expo": {
    "name": "Pausa",
    "slug": "Pausa",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/logopausa.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logopausa.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.github.OsvaldoMrn.Pausa",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logopausa.png",
        "backgroundColor": "#121212"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/logopausa.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "020f509a-33c2-4037-82a9-2b63db0b1949"
      }
    }
  }
}
